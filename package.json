{
  "name": "@agentmemory/agentmemory",
  "version": "0.9.29",
  "description": "Persistent memory for AI coding agents, powered by iii-engine's three primitives",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./dist/standalone.mjs": "./dist/standalone.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "agentmemory": "dist/cli.mjs"
  },
  "scripts": {
    "build": "tsdown && (cp iii-config.yaml dist/ 2>/dev/null || true) && (cp iii-config.docker.yaml dist/ 2>/dev/null || true) && (cp docker-compose.yml dist/ 2>/dev/null || true) && (cp .env.example dist/ 2>/dev/null || true) && mkdir -p dist/viewer && cp src/viewer/index.html dist/viewer/ && cp src/viewer/favicon.svg dist/viewer/",
    "dev": "bun src/index.ts",
    "start": "bun dist/cli.mjs",
    "migrate": "bun dist/functions/migrate.js",
    "test": "bun test --isolate --timeout 10000 --path-ignore-patterns='**/integration.test.ts' --path-ignore-patterns='**/iii-runtime-smoke.test.ts'",
    "test:watch": "bun test --watch --isolate --timeout 10000 --path-ignore-patterns='**/integration.test.ts' --path-ignore-patterns='**/iii-runtime-smoke.test.ts'",
    "test:integration": "bun test --isolate --timeout 10000 ./test/integration.test.ts",
    "test:runtime": "AGENTMEMORY_RUNTIME_SMOKE=1 bun test --isolate --timeout 30000 ./test/iii-runtime-smoke.test.ts",
    "test:all": "bun test --isolate --timeout 10000",
    "skills:gen": "bun scripts/skills/generate.ts",
    "skills:check": "bun scripts/skills/generate.ts --check && bun scripts/skills/check.ts",
    "bench:load": "bun benchmark/load-100k.ts",
    "eval:longmemeval": "bun eval/runner/longmemeval.ts",
    "eval:coding-life": "bun eval/runner/coding-life.ts"
  },
  "keywords": [
    "ai",
    "agent",
    "memory",
    "persistent",
    "iii-engine",
    "claude-code",
    "coding-agent",
    "context",
    "observation"
  ],
  "files": [
    "dist/",
    "plugin/",
    "integrations/pi/",
    "iii-config.yaml",
    "iii-config.docker.yaml",
    "docker-compose.yml",
    ".env.example",
    "LICENSE",
    "README.md",
    "AGENTS.md"
  ],
  "author": "Rohit Ghumare <ghumare64@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/rohitg00/agentmemory"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.142",
    "@anthropic-ai/sdk": "^0.100.1",
    "@clack/prompts": "^1.2.0",
    "dotenv": "^17.4.2",
    "iii-sdk": "0.19.7",
    "picocolors": "^1.1.1",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@node-rs/jieba": "^2.0.1",
    "tiny-segmenter": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "bun-types": "^1.3.13",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "qs": "^6.15.2",
    "ws": "^8.21.0",
    "protobufjs": "^7.5.8"
  },
  "engines": {
    "bun": ">=1.3.13"
  }
}
